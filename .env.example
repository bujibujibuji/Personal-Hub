# web 对外端口：手机 App / 浏览器访问 http://服务器IP:这个端口
WEB_PORT=8081

# 站点域名（可选）：只有绑定域名 + HTTPS 时才需要填写，例如 hub.example.com；
# IP 直连模式保持留空即可。
SITE_ADDRESS=

# GitHub 用户名（仓库所属账号），用于从 GHCR 拉取镜像
GHCR_OWNER=your-github-username

# 使用的镜像标签；回滚旧版本时可改成具体的 commit SHA
TAG=latest

DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
PERSONAL_HUB_ADMIN_USERNAME=admin
PERSONAL_HUB_ADMIN_PASSWORD=replace-with-your-own-password-at-least-8-characters
